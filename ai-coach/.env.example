# Copy to ai-coach/.env (never commit .env). This module reads its own .env,
# separate from the root one the backend uses.

# Required. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional override; defaults to gemini-3.8-flash
GEMINI_MODEL=

# Optional - if unset, synthesize_speech_base64 returns None and ask_pt still
# works text-only. https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
