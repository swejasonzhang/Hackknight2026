# Copy to .env at the repo root (never commit .env). Only the backend reads it.

# Required. MongoDB Atlas connection string, e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ptg?retryWrites=true&w=majority
# The database name (here "ptg") goes right after the host.
MONGODB_URI=

# API port (the Vite dev server proxies /api here)
PORT=8787

# Comma-separated browser origins allowed to call the API in production
# CORS_ORIGINS=https://app.yourdomain.com

# Required. Signs the login tokens; any long random string: `openssl rand -hex 32`
JWT_SECRET=

# Shared secret the computer-vision module sends as the `x-api-key` header when it
# stores sessions (POST /api/sessions) or reads a profile's plan. `openssl rand -hex 32`
CV_API_KEY=
