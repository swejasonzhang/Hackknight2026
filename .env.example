# Copy to .env at the repo root (never commit .env). Only the backend reads it.

# Required. MongoDB Atlas connection string, e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/arc?retryWrites=true&w=majority
# The database name (here "arc") goes right after the host.
MONGODB_URI=

# API port (the Vite dev server proxies /api here)
PORT=8787

# Comma-separated browser origins allowed to call the API in production
# CORS_ORIGINS=https://getarc.health,https://www.getarc.health

# Required. Signs the login tokens; any long random string: `openssl rand -hex 32`
JWT_SECRET=

# Shared secret the camera app sends as the `x-api-key` header when it stores
# sessions (POST /api/sessions) or reads a profile's plan. `openssl rand -hex 32`
# Optional: without it the API starts, but the camera app cannot store sessions.
CV_API_KEY=

# Optional. Arc's words from Gemini (onboarding chat, set and session reads, the week).
# Without it Arc asks its own questions and reads sessions from templates.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Optional. Arc's voice from ElevenLabs; without it the browser speaks Arc's lines.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Optional. How many Arc requests one account may make a minute (default 40).
# COACH_MAX_PER_MINUTE=40
